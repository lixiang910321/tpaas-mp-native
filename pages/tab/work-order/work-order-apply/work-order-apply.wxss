.page {
  min-height: 100%;
  background-color: #f8f8f8;
  box-sizing: border-box;
}

.scroll {
  height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.state-card {
  margin: 24rpx;
  padding: 48rpx 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
  text-align: center;
}

.state-card.err {
  background: #fff3f0;
}

.state-text {
  font-size: 28rpx;
  color: #333333;
}

.section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #000000;
  margin-bottom: 20rpx;
}

.required {
  color: #ff4d4f;
}

.empty-tip {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  padding: 32rpx 0;
}

/* 人员网格 */
.member-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.member-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
  background: #fafafa;
}

.member-selected {
  border-color: #7467ef;
  background: #f5f3ff;
}

.member-disabled {
  opacity: 0.45;
  pointer-events: none;
}

.member-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
}

.member-profession {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999999;
}

.member-occupied {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #ff4d4f;
}

/* 选择行 */
.choose-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  background: #fafafa;
}

.choose-placeholder {
  font-size: 26rpx;
  color: #c8c9cc;
}

.choose-text {
  font-size: 26rpx;
  color: #7467ef;
}

.choose-arrow {
  font-size: 32rpx;
  color: #c8c9cc;
}

/* 标签列表 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: #f5f3ff;
  border-radius: 8rpx;
  border: 1rpx solid rgba(116, 103, 239, 0.2);
}

.tag-text {
  font-size: 24rpx;
  color: #7467ef;
}

.tag-remove {
  font-size: 28rpx;
  color: #999999;
  line-height: 1;
  padding-left: 4rpx;
}

/* 备注输入 */
.remark-input {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #fafafa;
  box-sizing: border-box;
}

/* 提交按钮 */
.submit-bar {
  padding: 16rpx 0 40rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(90deg, #7467ef, #5a4fdf);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #cccccc;
}
