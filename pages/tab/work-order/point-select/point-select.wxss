.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 160rpx;
}

.header {
  background: #fff;
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #323233;
}

.step-list {
  margin: 24rpx;
}

.step-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
}

.step-item.disabled {
  opacity: 0.5;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 50%;
  background: #7b68ee;
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.step-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.step-label {
  font-size: 28rpx;
  color: #323233;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.step-value {
  font-size: 24rpx;
  color: #323233;
}

.step-value.placeholder {
  color: #c8c9cc;
}

.step-arrow {
  font-size: 36rpx;
  color: #c8c9cc;
  margin-left: 16rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn-confirm {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 8rpx;
  background: #7b68ee;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-confirm::after {
  border: none;
}

.btn-confirm[disabled] {
  background: #c8c9cc;
  color: #fff;
}
